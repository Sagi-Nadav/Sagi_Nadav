# Microsoft Azure App Registration
# portal.azure.com → Azure AD → App registrations → New registration
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_TENANT_ID=your-tenant-id-here
AZURE_REDIRECT_URI=https://your-app.railway.app/auth/callback

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# App Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-random-32-byte-hex-string-here
SESSION_COOKIE_NAME=pa_session

# Database (optional override — defaults to sqlite:///./data/assistant.db)
DATABASE_URL=sqlite:///./data/assistant.db

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=https://your-app.railway.app,http://localhost:8000
